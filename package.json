{
  "name": "cryptovalid",
  "version": "0.4.0",
  "description": "Lightweight crypto address validator with checksum verification for Bitcoin, Ethereum, Solana and more",
  "keywords": [
    "address-validator",
    "base58",
    "bech32",
    "bitcoin",
    "checksum",
    "crypto-address-validator",
    "eip55",
    "ethereum",
    "solana",
    "wallet"
  ],
  "homepage": "https://github.com/fantasy42/cryptovalid#readme",
  "bugs": {
    "url": "https://github.com/fantasy42/cryptovalid/issues"
  },
  "license": "MIT",
  "author": "Fantasy <fntsy42@pm.me>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fantasy42/cryptovalid.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
